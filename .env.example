# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
SHARED_APP_URL="https://ais-pre-eankapwjyahdkgb2dgpirq-768850777108.europe-west2.run.app"
VITE_PUBLIC_APP_URL="https://ais-pre-eankapwjyahdkgb2dgpirq-768850777108.europe-west2.run.app"

# Gmail / SMTP Configuration for Real Admin OTP Emails (vortexstore.team@gmail.com)
# Configure SMTP_USER (your Gmail address) and SMTP_PASS (16-char Google App Password) in AI Studio Secrets.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Google Maps Platform API Key (provisioned via AI Studio Google Maps setup or Secrets)
VITE_GOOGLE_MAPS_API_KEY=""

# OpenWeather API Key (optional — automatic live Open-Meteo fallback for Edku 31.3069, 30.2981 when unset)
OPENWEATHER_API_KEY=""

# Firebase App Check reCAPTCHA v3 Site Key (optional — activates client App Check token protection when configured)
VITE_RECAPTCHA_V3_SITE_KEY=""

# Admin Portal Security (configured via environment or one-time first-run setup UI)
# ADMIN_PASSWORD_HASH accepts "scrypt$<salt>$<hex>" (recommended) or ADMIN_PASSWORD
ADMIN_EMAIL="vortexstore.team@gmail.com"
ADMIN_PASSWORD_HASH=""

# Paymob Webhook HMAC SHA-512 Secret (mandatory for /api/webhook verification)
PAYMOB_HMAC_SECRET=""

# Comma-separated CORS allowlist origins (optional in addition to APP_URL/SHARED_APP_URL)
ALLOWED_ORIGINS=""

